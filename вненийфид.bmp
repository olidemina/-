&НаКлиенте
Процедура ЗагрузитьСправку(Команда)
	ПараметрыДиалога = Новый ПараметрыДиалогаПомещенияФайлов;
	ПараметрыДиалога.Фильтр = "Изображения (*.jpg;*.jpeg;*.png)|*.jpg;*.jpeg;*.png";
	Оповещение = Новый ОписаниеОповещения("ПослеЗагрузкиСправки", ЭтаФорма);
	НачатьПомещениеФайлаНаСервер(Оповещение, , , , ПараметрыДиалога, УникальныйИдентификатор);
КонецПроцедуры

&НаКлиенте
Процедура ПослеЗагрузкиСправки(ОписаниеФайла, ДополнительныеПараметры) Экспорт
	Если ОписаниеФайла <> Неопределено Тогда
		АдресСправки = ОписаниеФайла.Адрес;
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ФИОСтудентаНачалоВыбора(Элемент, ДанныеВыбора, ВыборДобавлением, СтандартнаяОбработка)

	Список = ПолучитьСписокСтудентовНаСервере();

	Элемент.СписокВыбора.Очистить();

	Для Каждого Стр Из Список Цикл
		Элемент.СписокВыбора.Добавить(Стр.Значение, Стр.Представление);
	КонецЦикла;

КонецПроцедуры

&НаСервереБезКонтекста
Функция ПолучитьСписокСтудентовНаСервере()

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Студенты.Наименование КАК Представление
	|ИЗ
	|	Справочник.Студенты КАК Студенты
	|ГДЕ
	|	НЕ Студенты.ПометкаУдаления
	|УПОРЯДОЧИТЬ ПО
	|	Студенты.Наименование";

	Выборка = Запрос.Выполнить().Выбрать();

	Список = Новый СписокЗначений;

	Пока Выборка.Следующий() Цикл
		// ВАЖНО: значение тоже строка, а не ссылка
		Список.Добавить(Выборка.Представление, Выборка.Представление);
	КонецЦикла;

	Возврат Список;

КонецФункции

&НаКлиенте
Процедура ФИОСтудентаОбработкаВыбора(Элемент, ВыбранноеЗначение, ДополнительныеДанные, ВыборДобавлением, СтандартнаяОбработка)

	// Ничего не блокируем.
	// Стандартная обработка сама положит выбранную строку в ФИОСтудентаТекст.
	СтандартнаяОбработка = Истина;

КонецПроцедуры

&НаСервереБезКонтекста
Функция ПолучитьПредставлениеСтудентаНаСервере(Студент)

	Если Не ЗначениеЗаполнено(Студент) Тогда
		Возврат "";
	КонецЕсли;

	Возврат Строка(Студент);

КонецФункции

&НаСервереБезКонтекста
Функция ПолучитьФИОСтудентаНаСервере(Студент)

	Если Не ЗначениеЗаполнено(Студент) Тогда
		Возврат "";
	КонецЕсли;

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Студенты.Наименование КАК ФИО
	|ИЗ
	|	Справочник.Студенты КАК Студенты
	|ГДЕ
	|	Студенты.Ссылка = &Студент";

	Запрос.УстановитьПараметр("Студент", Студент);

	Выборка = Запрос.Выполнить().Выбрать();

	Если Выборка.Следующий() Тогда
		Возврат Выборка.ФИО;
	КонецЕсли;

	Возврат "";

КонецФункции

&НаКлиенте
Процедура ФИОСтудентаПриИзменении(Элемент)

	Если ПустаяСтрока(СокрЛП(ФИОСтудентаТекст)) Тогда
		ВыбранныйСтудент = ПолучитьПустуюСсылкуСтудентаНаСервере();
		Возврат;
	КонецЕсли;

	ВыбранныйСтудент = НайтиСтудентаПоФИОНасервере(ФИОСтудентаТекст);

	Если Не ЗначениеЗаполнено(ВыбранныйСтудент) Тогда
		Сообщить("Студент с таким ФИО не найден. Выберите ФИО из списка.");
	КонецЕсли;

КонецПроцедуры

&НаСервереБезКонтекста
Функция НайтиСтудентаПоФИОНасервере(ФИО)

	ФИО = СокрЛП(ФИО);

	Если ПустаяСтрока(ФИО) Тогда
		Возврат Справочники.Студенты.ПустаяСсылка();
	КонецЕсли;

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	Студенты.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.Студенты КАК Студенты
	|ГДЕ
	|	Студенты.Наименование = &ФИО
	|	И НЕ Студенты.ПометкаУдаления";

	Запрос.УстановитьПараметр("ФИО", ФИО);

	Выборка = Запрос.Выполнить().Выбрать();

	Если Выборка.Следующий() Тогда
		Возврат Выборка.Ссылка;
	КонецЕсли;

	Возврат Справочники.Студенты.ПустаяСсылка();

КонецФункции

&НаСервереБезКонтекста
Функция ПолучитьПустуюСсылкуСтудентаНаСервере()

	Возврат Справочники.Студенты.ПустаяСсылка();

КонецФункции

&НаКлиенте
Процедура ОтправитьНаПроверку(Команда)

	Если Не ЗначениеЗаполнено(ВыбранныйСтудент) Тогда
		ВыбранныйСтудент = НайтиСтудентаПоФИОНасервере(ФИОСтудентаТекст);
	КонецЕсли;

	Если Не ЗначениеЗаполнено(ВыбранныйСтудент) Тогда
		Сообщить("Сначала выберите ФИО студента из списка!");
		Возврат;
	КонецЕсли;

	Если ПустаяСтрока(СокрЛП(ПричинаОтсутствия)) Тогда
		Сообщить("Укажите причину отсутствия!");
		Возврат;
	КонецЕсли;

	ЗаписатьВБазуНаСервере();

	// Сразу обновляем правую HTML-панель
	ПосмотретьНаСервере();

КонецПроцедуры

&НаСервере
Процедура ЗаписатьВБазуНаСервере()

	НовыйДок = Документы.УведомлениеОбОтсутствии.СоздатьДокумент();

	НовыйДок.Дата = ТекущаяДата();
	НовыйДок.Студент = ВыбранныйСтудент;
	НовыйДок.Причина = ПричинаОтсутствия;

	Если ЗначениеЗаполнено(АдресСправки) Тогда
		НовыйДок.ФайлСправки = Новый ХранилищеЗначения(ПолучитьИзВременногоХранилища(АдресСправки));
	КонецЕсли;

	НовыйДок.Записать(РежимЗаписиДокумента.Проведение);

	Сообщить("Уведомление отправлено на проверку!");

КонецПроцедуры

&НаКлиенте
Процедура ПосмотретьМоюПосещаемость(Команда)

	Если Не ЗначениеЗаполнено(ВыбранныйСтудент) Тогда
		ВыбранныйСтудент = НайтиСтудентаПоФИОНасервере(ФИОСтудентаТекст);
	КонецЕсли;

	Если Не ЗначениеЗаполнено(ВыбранныйСтудент) Тогда
		Сообщить("Сначала выберите студента из списка!");
		Возврат;
	КонецЕсли;

	ПосмотретьНаСервере();

КонецПроцедуры


&НаСервере
Процедура ПосмотретьНаСервере()

	HTMLПосещаемости = СформироватьHTMLПосещаемостиСтудента(ВыбранныйСтудент);

КонецПроцедуры



&НаСервере
Процедура ДобавитьВСчетчик(Счетчик, Ключ, Прибавка = 1)

	КлючСтрокой = СокрЛП(Строка(Ключ));

	Если ПустаяСтрока(КлючСтрокой) Тогда
		КлючСтрокой = "Не указано";
	КонецЕсли;

	ТекущееЗначение = Счетчик.Получить(КлючСтрокой);

	Если ТекущееЗначение = Неопределено Тогда
		Счетчик.Вставить(КлючСтрокой, Прибавка);
	Иначе
		Счетчик.Вставить(КлючСтрокой, ТекущееЗначение + Прибавка);
	КонецЕсли;

КонецПроцедуры


&НаСервере
Функция СформироватьHTMLМетрика(Название, Значение, Подпись)

	HTML = "";
	HTML = HTML + "<div class='metric'>";
	HTML = HTML + "<div class='metric-title'>" + ЭкранироватьHTML(Название) + "</div>";
	HTML = HTML + "<div class='metric-value'>" + ЭкранироватьHTML(Строка(Значение)) + "</div>";
	HTML = HTML + "<div class='metric-note'>" + ЭкранироватьHTML(Подпись) + "</div>";
	HTML = HTML + "</div>";

	Возврат HTML;

КонецФункции


&НаСервере
Функция СформироватьHTMLРейтинг(Счетчик, ЕдиницаИзмерения, Лимит)

	Если Счетчик.Количество() = 0 Тогда
		Возврат "<div class='notice'>Нет данных для построения рейтинга.</div>";
	КонецЕсли;

	Таб = Новый ТаблицаЗначений;
	Таб.Колонки.Добавить("Название");
	Таб.Колонки.Добавить("Значение");

	Для Каждого ЭлементСчетчика Из Счетчик Цикл
		СтрТаб = Таб.Добавить();
		СтрТаб.Название = ЭлементСчетчика.Ключ;
		СтрТаб.Значение = ЭлементСчетчика.Значение;
	КонецЦикла;

	Таб.Сортировать("Значение УБЫВ");

	Максимум = 0;

	Для Каждого СтрТоп Из Таб Цикл
		Если СтрТоп.Значение > Максимум Тогда
			Максимум = СтрТоп.Значение;
		КонецЕсли;
	КонецЦикла;

	HTML = "";
	Номер = 0;

	Для Каждого СтрТоп Из Таб Цикл

		Номер = Номер + 1;

		Если Номер > Лимит Тогда
			Прервать;
		КонецЕсли;

		Если Максимум > 0 Тогда
			Ширина = Окр(СтрТоп.Значение * 100 / Максимум, 0);
		Иначе
			Ширина = 0;
		КонецЕсли;

		HTML = HTML
			+ "<div class='rank-row'>"
			+ "<div class='rank-head'>"
			+ "<span class='rank-name'>" + ЭкранироватьHTML(Строка(Номер) + ". " + Строка(СтрТоп.Название)) + "</span>"
			+ "<span class='rank-value'>" + ЭкранироватьHTML(Строка(СтрТоп.Значение) + " " + ЕдиницаИзмерения) + "</span>"
			+ "</div>"
			+ "<div class='bar'><div class='bar-fill' style='width:" + Строка(Ширина) + "%'></div></div>"
			+ "</div>";

	КонецЦикла;

	Возврат HTML;

КонецФункции


&НаСервере
Функция СформироватьHTMLПосещаемостиСтудента(Студент)

	// ============================================================
	// MAX HTML-ПАНЕЛЬ: личный кабинет + аналитика + контроль базы
	// ============================================================

	// ------------------------------------------------------------
	// 1. Чтение журнала посещаемости по всей базе
	// ------------------------------------------------------------

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Журнал.Ссылка КАК ДокументЖурнала,
	|	Журнал.Дата КАК Дата,
	|	Журнал.ВидЗанятия КАК ВидЗанятия,
	|	Журнал.УчебныйПериод КАК УчебныйПериод,
	|	Журнал.Аудитория КАК Аудитория,
	|	Журнал.УчебнаяГруппа КАК УчебнаяГруппа,
	|	СтрокиПосещаемости.Преподаватель КАК Преподаватель,
	|	СтрокиПосещаемости.Предмет КАК Предмет,
	|	СтрокиПосещаемости.Группа КАК Группа,
	|	СтрокиПосещаемости.Студент КАК Студент,
	|	СтрокиПосещаемости.Часы КАК Часы
	|ИЗ
	|	Документ.ЖурналПосещаемости.Посещаемость КАК СтрокиПосещаемости
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.ЖурналПосещаемости КАК Журнал
	|		ПО СтрокиПосещаемости.Ссылка = Журнал.Ссылка
	|ГДЕ
	|	НЕ Журнал.ПометкаУдаления
	|УПОРЯДОЧИТЬ ПО
	|	Журнал.Дата УБЫВ";

	Выборка = Запрос.Выполнить().Выбрать();

	КоличествоСтрокВБазе = 0;
	КоличествоСтрокСтудента = 0;

	ВсегоЧасовВБазе = 0;
	ВсегоЧасовСтудента = 0;

	ПоследняяДатаСтудента = Неопределено;
	ПерваяДатаСтудента = Неопределено;

	СтрокиЖурналаСтудента = "";
	СтрокиКонтроляКачества = "";

	УникальныеДокументыЖурнала = Новый Соответствие;
	УникальныеСтуденты = Новый Соответствие;
	УникальныеПреподаватели = Новый Соответствие;
	УникальныеПредметы = Новый Соответствие;
	УникальныеГруппы = Новый Соответствие;
	УникальныеПериоды = Новый Соответствие;
	УникальныеАудитории = Новый Соответствие;
	УникальныеВидыЗанятий = Новый Соответствие;

	УникальныеДатыСтудента = Новый Соответствие;
	ПредметыСтудента = Новый Соответствие;
	ПреподавателиСтудента = Новый Соответствие;
	ГруппыСтудента = Новый Соответствие;
	ПериодыСтудента = Новый Соответствие;

	РейтингПредметовПоЧасам = Новый Соответствие;
	РейтингПредметовПоЗаписям = Новый Соответствие;
	РейтингПреподавателей = Новый Соответствие;
	РейтингГрупп = Новый Соответствие;
	РейтингМесяцев = Новый Соответствие;
	РейтингВидовЗанятий = Новый Соответствие;
	РейтингПериодов = Новый Соответствие;
	РейтингАудиторий = Новый Соответствие;

	РейтингБазыПредметы = Новый Соответствие;
	РейтингБазыПреподаватели = Новый Соответствие;
	РейтингБазыГруппы = Новый Соответствие;
	РейтингБазыМесяцы = Новый Соответствие;

	ПустыхПредметовСтудента = 0;
	ПустыхПреподавателейСтудента = 0;
	ПустыхГруппСтудента = 0;
	ПустыхЧасовСтудента = 0;
	ПустыхВидовЗанятийСтудента = 0;

	ПустыхПредметовБаза = 0;
	ПустыхПреподавателейБаза = 0;
	ПустыхГруппБаза = 0;
	ПустыхЧасовБаза = 0;
	ПустыхВидовЗанятийБаза = 0;

	Пока Выборка.Следующий() Цикл

		КоличествоСтрокВБазе = КоличествоСтрокВБазе + 1;

		Если ЗначениеЗаполнено(Выборка.Часы) Тогда
			ВсегоЧасовВБазе = ВсегоЧасовВБазе + Выборка.Часы;
		Иначе
			ПустыхЧасовБаза = ПустыхЧасовБаза + 1;
		КонецЕсли;

		Если ЗначениеЗаполнено(Выборка.ДокументЖурнала) Тогда
			УникальныеДокументыЖурнала.Вставить(Выборка.ДокументЖурнала, Истина);
		КонецЕсли;

		Если ЗначениеЗаполнено(Выборка.Студент) Тогда
			УникальныеСтуденты.Вставить(Выборка.Студент, Истина);
		КонецЕсли;

		Если ЗначениеЗаполнено(Выборка.Преподаватель) Тогда
			УникальныеПреподаватели.Вставить(Строка(Выборка.Преподаватель), Истина);
			ДобавитьВСчетчик(РейтингБазыПреподаватели, Строка(Выборка.Преподаватель), 1);
		Иначе
			ПустыхПреподавателейБаза = ПустыхПреподавателейБаза + 1;
		КонецЕсли;

		Если ЗначениеЗаполнено(Выборка.Предмет) Тогда
			УникальныеПредметы.Вставить(Строка(Выборка.Предмет), Истина);
			ДобавитьВСчетчик(РейтингБазыПредметы, Строка(Выборка.Предмет), 1);
		Иначе
			ПустыхПредметовБаза = ПустыхПредметовБаза + 1;
		КонецЕсли;

		Если ЗначениеЗаполнено(Выборка.Группа) Тогда
			УникальныеГруппы.Вставить(Строка(Выборка.Группа), Истина);
			ДобавитьВСчетчик(РейтингБазыГруппы, Строка(Выборка.Группа), 1);
		Иначе
			ПустыхГруппБаза = ПустыхГруппБаза + 1;
		КонецЕсли;

		Если ЗначениеЗаполнено(Выборка.УчебныйПериод) Тогда
			УникальныеПериоды.Вставить(Строка(Выборка.УчебныйПериод), Истина);
		КонецЕсли;

		Если ЗначениеЗаполнено(Выборка.Аудитория) Тогда
			УникальныеАудитории.Вставить(Строка(Выборка.Аудитория), Истина);
		КонецЕсли;

		Если ЗначениеЗаполнено(Выборка.ВидЗанятия) Тогда
			УникальныеВидыЗанятий.Вставить(Строка(Выборка.ВидЗанятия), Истина);
		Иначе
			ПустыхВидовЗанятийБаза = ПустыхВидовЗанятийБаза + 1;
		КонецЕсли;

		Если ЗначениеЗаполнено(Выборка.Дата) Тогда
			ДобавитьВСчетчик(РейтингБазыМесяцы, Формат(Выборка.Дата, "ДФ=MM.yyyy"), 1);
		КонецЕсли;


		// ------------------------------------------------------------
		// Данные выбранного студента
		// ------------------------------------------------------------

		Если Выборка.Студент = Студент Тогда

			КоличествоСтрокСтудента = КоличествоСтрокСтудента + 1;

			Если ЗначениеЗаполнено(Выборка.Часы) Тогда
				ВсегоЧасовСтудента = ВсегоЧасовСтудента + Выборка.Часы;
			Иначе
				ПустыхЧасовСтудента = ПустыхЧасовСтудента + 1;
			КонецЕсли;

			Если ПоследняяДатаСтудента = Неопределено Тогда
				ПоследняяДатаСтудента = Выборка.Дата;
			КонецЕсли;

			ПерваяДатаСтудента = Выборка.Дата;

			Если ЗначениеЗаполнено(Выборка.Дата) Тогда
				УникальныеДатыСтудента.Вставить(Формат(Выборка.Дата, "ДФ=yyyyMMdd"), Истина);
				ДобавитьВСчетчик(РейтингМесяцев, Формат(Выборка.Дата, "ДФ=MM.yyyy"), 1);
			КонецЕсли;

			Если ЗначениеЗаполнено(Выборка.Предмет) Тогда
				ПредметыСтудента.Вставить(Строка(Выборка.Предмет), Истина);
				ДобавитьВСчетчик(РейтингПредметовПоЗаписям, Строка(Выборка.Предмет), 1);

				Если ЗначениеЗаполнено(Выборка.Часы) Тогда
					ДобавитьВСчетчик(РейтингПредметовПоЧасам, Строка(Выборка.Предмет), Выборка.Часы);
				КонецЕсли;
			Иначе
				ПустыхПредметовСтудента = ПустыхПредметовСтудента + 1;
			КонецЕсли;

			Если ЗначениеЗаполнено(Выборка.Преподаватель) Тогда
				ПреподавателиСтудента.Вставить(Строка(Выборка.Преподаватель), Истина);
				ДобавитьВСчетчик(РейтингПреподавателей, Строка(Выборка.Преподаватель), 1);
			Иначе
				ПустыхПреподавателейСтудента = ПустыхПреподавателейСтудента + 1;
			КонецЕсли;

			Если ЗначениеЗаполнено(Выборка.Группа) Тогда
				ГруппыСтудента.Вставить(Строка(Выборка.Группа), Истина);
				ДобавитьВСчетчик(РейтингГрупп, Строка(Выборка.Группа), 1);
			Иначе
				ПустыхГруппСтудента = ПустыхГруппСтудента + 1;
			КонецЕсли;

			Если ЗначениеЗаполнено(Выборка.УчебныйПериод) Тогда
				ПериодыСтудента.Вставить(Строка(Выборка.УчебныйПериод), Истина);
				ДобавитьВСчетчик(РейтингПериодов, Строка(Выборка.УчебныйПериод), 1);
			КонецЕсли;

			Если ЗначениеЗаполнено(Выборка.ВидЗанятия) Тогда
				ДобавитьВСчетчик(РейтингВидовЗанятий, Строка(Выборка.ВидЗанятия), 1);
			Иначе
				ПустыхВидовЗанятийСтудента = ПустыхВидовЗанятийСтудента + 1;
			КонецЕсли;

			Если ЗначениеЗаполнено(Выборка.Аудитория) Тогда
				ДобавитьВСчетчик(РейтингАудиторий, Строка(Выборка.Аудитория), 1);
			КонецЕсли;

			СтрокиЖурналаСтудента = СтрокиЖурналаСтудента
				+ "<tr>"
				+ "<td>" + ЭкранироватьHTML(ФорматДатыHTML(Выборка.Дата)) + "</td>"
				+ "<td>" + ЭкранироватьHTML(Строка(Выборка.ВидЗанятия)) + "</td>"
				+ "<td>" + ЭкранироватьHTML(Строка(Выборка.УчебныйПериод)) + "</td>"
				+ "<td>" + ЭкранироватьHTML(Строка(Выборка.Аудитория)) + "</td>"
				+ "<td>" + ЭкранироватьHTML(Строка(Выборка.УчебнаяГруппа)) + "</td>"
				+ "<td>" + ЭкранироватьHTML(Строка(Выборка.Преподаватель)) + "</td>"
				+ "<td>" + ЭкранироватьHTML(Строка(Выборка.Предмет)) + "</td>"
				+ "<td>" + ЭкранироватьHTML(Строка(Выборка.Группа)) + "</td>"
				+ "<td class='num'>" + ЭкранироватьHTML(Строка(Выборка.Часы)) + "</td>"
				+ "</tr>";

		КонецЕсли;

	КонецЦикла;


	// ------------------------------------------------------------
	// 2. Уведомления об отсутствии
	// ------------------------------------------------------------

	ЗапросУведомления = Новый Запрос;
	ЗапросУведомления.Текст =
	"ВЫБРАТЬ
	|	Уведомление.Дата КАК Дата,
	|	Уведомление.Студент КАК Студент,
	|	Уведомление.Причина КАК Причина,
	|	Уведомление.ФайлСправки КАК ФайлСправки
	|ИЗ
	|	Документ.УведомлениеОбОтсутствии КАК Уведомление
	|ГДЕ
	|	НЕ Уведомление.ПометкаУдаления
	|УПОРЯДОЧИТЬ ПО
	|	Уведомление.Дата УБЫВ";

	ВыборкаУведомления = ЗапросУведомления.Выполнить().Выбрать();

	КоличествоУведомленийВБазе = 0;
	КоличествоУведомленийСтудента = 0;

	УведомленийСФайломВБазе = 0;
	УведомленийСФайломСтудента = 0;

	УведомленийБезФайлаВБазе = 0;
	УведомленийБезФайлаСтудента = 0;

	СтрокиУведомленийСтудента = "";

	РейтингПричинСтудента = Новый Соответствие;
	РейтингПричинБаза = Новый Соответствие;

	Пока ВыборкаУведомления.Следующий() Цикл

		КоличествоУведомленийВБазе = КоличествоУведомленийВБазе + 1;

		Если ЗначениеЗаполнено(ВыборкаУведомления.ФайлСправки) Тогда
			УведомленийСФайломВБазе = УведомленийСФайломВБазе + 1;
		Иначе
			УведомленийБезФайлаВБазе = УведомленийБезФайлаВБазе + 1;
		КонецЕсли;

		Если ЗначениеЗаполнено(ВыборкаУведомления.Причина) Тогда
			ДобавитьВСчетчик(РейтингПричинБаза, Лев(Строка(ВыборкаУведомления.Причина), 60), 1);
		Иначе
			ДобавитьВСчетчик(РейтингПричинБаза, "Причина не указана", 1);
		КонецЕсли;

		Если ВыборкаУведомления.Студент = Студент Тогда

			КоличествоУведомленийСтудента = КоличествоУведомленийСтудента + 1;

			Если ЗначениеЗаполнено(ВыборкаУведомления.Причина) Тогда
				ДобавитьВСчетчик(РейтингПричинСтудента, Лев(Строка(ВыборкаУведомления.Причина), 60), 1);
			Иначе
				ДобавитьВСчетчик(РейтингПричинСтудента, "Причина не указана", 1);
			КонецЕсли;

			Если ЗначениеЗаполнено(ВыборкаУведомления.ФайлСправки) Тогда
				УведомленийСФайломСтудента = УведомленийСФайломСтудента + 1;
				ТекстСправки = "Прикреплена";
				КлассСправки = "badge ok";
			Иначе
				УведомленийБезФайлаСтудента = УведомленийБезФайлаСтудента + 1;
				ТекстСправки = "Нет файла";
				КлассСправки = "badge muted";
			КонецЕсли;

			СтрокиУведомленийСтудента = СтрокиУведомленийСтудента
				+ "<tr>"
				+ "<td>" + ЭкранироватьHTML(Формат(ВыборкаУведомления.Дата, "ДФ=dd.MM.yyyy HH:mm")) + "</td>"
				+ "<td>" + ЭкранироватьHTML(Строка(ВыборкаУведомления.Причина)) + "</td>"
				+ "<td><span class='" + КлассСправки + "'>" + ТекстСправки + "</span></td>"
				+ "<td><span class='badge warn'>На рассмотрении</span></td>"
				+ "</tr>";

		КонецЕсли;

	КонецЦикла;


	// ------------------------------------------------------------
	// 3. Расчёт KPI
	// ------------------------------------------------------------

	Если КоличествоСтрокСтудента > 0 Тогда
		СреднееЧасовСтудента = Окр(ВсегоЧасовСтудента / КоличествоСтрокСтудента, 2);
	Иначе
		СреднееЧасовСтудента = 0;
	КонецЕсли;

	Если КоличествоСтрокВБазе > 0 Тогда
		СреднееЧасовБазы = Окр(ВсегоЧасовВБазе / КоличествоСтрокВБазе, 2);
		ДоляСтудентаВБазе = Окр(КоличествоСтрокСтудента * 100 / КоличествоСтрокВБазе, 1);
	Иначе
		СреднееЧасовБазы = 0;
		ДоляСтудентаВБазе = 0;
	КонецЕсли;

	Если КоличествоУведомленийСтудента > 0 Тогда
		ДоляСправокСтудента = Окр(УведомленийСФайломСтудента * 100 / КоличествоУведомленийСтудента, 1);
	Иначе
		ДоляСправокСтудента = 0;
	КонецЕсли;

	Если КоличествоУведомленийВБазе > 0 Тогда
		ДоляСправокБаза = Окр(УведомленийСФайломВБазе * 100 / КоличествоУведомленийВБазе, 1);
	Иначе
		ДоляСправокБаза = 0;
	КонецЕсли;

	ВсегоПустыхПолейСтудента = ПустыхПредметовСтудента + ПустыхПреподавателейСтудента + ПустыхГруппСтудента + ПустыхЧасовСтудента + ПустыхВидовЗанятийСтудента;
	ВсегоКонтролируемыхПолейСтудента = КоличествоСтрокСтудента * 5;

	Если ВсегоКонтролируемыхПолейСтудента > 0 Тогда
		ИндексКачестваСтудента = 100 - Окр(ВсегоПустыхПолейСтудента * 100 / ВсегоКонтролируемыхПолейСтудента, 1);
	Иначе
		ИндексКачестваСтудента = 0;
	КонецЕсли;

	ВсегоПустыхПолейБаза = ПустыхПредметовБаза + ПустыхПреподавателейБаза + ПустыхГруппБаза + ПустыхЧасовБаза + ПустыхВидовЗанятийБаза;
	ВсегоКонтролируемыхПолейБаза = КоличествоСтрокВБазе * 5;

	Если ВсегоКонтролируемыхПолейБаза > 0 Тогда
		ИндексКачестваБазы = 100 - Окр(ВсегоПустыхПолейБаза * 100 / ВсегоКонтролируемыхПолейБаза, 1);
	Иначе
		ИндексКачестваБазы = 0;
	КонецЕсли;

	Если ПоследняяДатаСтудента = Неопределено Тогда
		ТекстПоследнейДаты = "Нет данных";
	Иначе
		ТекстПоследнейДаты = Формат(ПоследняяДатаСтудента, "ДФ=dd.MM.yyyy");
	КонецЕсли;

	Если ПерваяДатаСтудента = Неопределено Тогда
		ТекстПервойДаты = "Нет данных";
	Иначе
		ТекстПервойДаты = Формат(ПерваяДатаСтудента, "ДФ=dd.MM.yyyy");
	КонецЕсли;

	Если ПустаяСтрока(СтрокиЖурналаСтудента) Тогда
		СтрокиЖурналаСтудента = "<tr><td colspan='9' class='empty-cell'>По выбранному студенту пока нет записей в журнале.</td></tr>";
	КонецЕсли;

	Если ПустаяСтрока(СтрокиУведомленийСтудента) Тогда
		СтрокиУведомленийСтудента = "<tr><td colspan='4' class='empty-cell'>Студент пока не отправлял уведомления об отсутствии.</td></tr>";
	КонецЕсли;


	// ------------------------------------------------------------
	// 4. Автоматические выводы и предупреждения
	// ------------------------------------------------------------

	HTMLВыводы = "";
	HTMLРиски = "";
	HTMLРекомендации = "";

	Если КоличествоСтрокСтудента = 0 Тогда
		HTMLРиски = HTMLРиски + СформироватьHTMLСообщение("risk", "Нет записей в журнале по выбранному студенту. Проверьте выбор ФИО и заполнение документа ЖурналПосещаемости.");
		HTMLРекомендации = HTMLРекомендации + "<li>Проверить, что в журнале посещаемости в табличной части выбран именно этот студент.</li>";
	Иначе
		HTMLВыводы = HTMLВыводы + "<li>По студенту найдено записей в журнале: <b>" + Строка(КоличествоСтрокСтудента) + "</b>.</li>";
	КонецЕсли;

	Если КоличествоУведомленийСтудента = 0 Тогда
		HTMLРиски = HTMLРиски + СформироватьHTMLСообщение("warnbox", "У студента нет отправленных уведомлений об отсутствии. Если в журнале есть пропуски, это зона контроля.");
		HTMLРекомендации = HTMLРекомендации + "<li>Проверить, должен ли студент отправить уведомление об отсутствии.</li>";
	Иначе
		HTMLВыводы = HTMLВыводы + "<li>Студент отправил уведомлений: <b>" + Строка(КоличествоУведомленийСтудента) + "</b>.</li>";
	КонецЕсли;

	Если УведомленийБезФайлаСтудента > 0 Тогда
		HTMLРиски = HTMLРиски + СформироватьHTMLСообщение("warnbox", "Есть уведомления без прикрепленной справки: " + Строка(УведомленийБезФайлаСтудента) + ".");
		HTMLРекомендации = HTMLРекомендации + "<li>Запросить у студента подтверждающий документ, если причина требует справку.</li>";
	КонецЕсли;

	Если ИндексКачестваСтудента < 80 И КоличествоСтрокСтудента > 0 Тогда
		HTMLРиски = HTMLРиски + СформироватьHTMLСообщение("risk", "Низкий индекс заполненности данных по студенту: " + Строка(ИндексКачестваСтудента) + "%.");
		HTMLРекомендации = HTMLРекомендации + "<li>Дозаполнить пустые поля в журнале: предмет, преподаватель, группа, часы, вид занятия.</li>";
	ИначеЕсли КоличествоСтрокСтудента > 0 Тогда
		HTMLВыводы = HTMLВыводы + "<li>Индекс заполненности данных по студенту: <b>" + Строка(ИндексКачестваСтудента) + "%</b>.</li>";
	КонецЕсли;

	Если ПустаяСтрока(HTMLРиски) Тогда
		HTMLРиски = СформироватьHTMLСообщение("goodbox", "Критических проблем по выбранному студенту не обнаружено.");
	КонецЕсли;

	Если ПустаяСтрока(HTMLРекомендации) Тогда
		HTMLРекомендации = "<li>Продолжать вести журнал посещаемости и своевременно проверять уведомления.</li>";
	КонецЕсли;


	// ------------------------------------------------------------
	// 5. Строки контроля качества
	// ------------------------------------------------------------

	СтрокиКонтроляКачества = СтрокиКонтроляКачества
		+ СформироватьHTMLСтрокуКачества("Пустой предмет", ПустыхПредметовСтудента, ПустыхПредметовБаза)
		+ СформироватьHTMLСтрокуКачества("Пустой преподаватель", ПустыхПреподавателейСтудента, ПустыхПреподавателейБаза)
		+ СформироватьHTMLСтрокуКачества("Пустая группа", ПустыхГруппСтудента, ПустыхГруппБаза)
		+ СформироватьHTMLСтрокуКачества("Пустые часы", ПустыхЧасовСтудента, ПустыхЧасовБаза)
		+ СформироватьHTMLСтрокуКачества("Пустой вид занятия", ПустыхВидовЗанятийСтудента, ПустыхВидовЗанятийБаза);


	// ------------------------------------------------------------
	// 6. HTML
	// ------------------------------------------------------------

	HTML = "";

	HTML = HTML + "<!DOCTYPE html>";
	HTML = HTML + "<html>";
	HTML = HTML + "<head>";
	HTML = HTML + "<meta charset='utf-8'>";

	HTML = HTML + "<style>";
	HTML = HTML + "body{font-family:Segoe UI,Arial,sans-serif;background:#f2eef8;margin:0;padding:14px;color:#282033;}";
	HTML = HTML + ".page{width:100%;box-sizing:border-box;}";
	HTML = HTML + ".hero{background:#5e2494;color:white;border-radius:18px;padding:20px 22px;margin-bottom:12px;box-shadow:0 8px 22px rgba(80,32,120,.28);}";
	HTML = HTML + ".hero h1{font-size:26px;margin:0 0 6px 0;}";
	HTML = HTML + ".hero p{margin:4px 0;font-size:13px;}";
	HTML = HTML + ".hero-line{margin-top:10px;display:flex;flex-wrap:wrap;gap:8px;}";
	HTML = HTML + ".pill{display:inline-block;background:rgba(255,255,255,.18);border:1px solid rgba(255,255,255,.35);border-radius:999px;padding:5px 9px;font-size:12px;}";
	HTML = HTML + ".tabs{display:flex;flex-wrap:wrap;gap:7px;margin-bottom:12px;}";
	HTML = HTML + ".tab-button{border:1px solid #d8c8ec;background:white;color:#4d216f;border-radius:999px;padding:8px 12px;cursor:pointer;font-size:12px;font-weight:bold;}";
	HTML = HTML + ".tab-button.active{background:#7b3fb2;color:white;border-color:#7b3fb2;}";
	HTML = HTML + ".tab-content{display:none;}";
	HTML = HTML + ".tab-content.active{display:block;}";
	HTML = HTML + ".grid{display:flex;flex-wrap:wrap;gap:10px;margin-bottom:12px;}";
	HTML = HTML + ".metric{background:white;border:1px solid #e7dbf2;border-radius:15px;padding:12px;box-shadow:0 3px 12px rgba(0,0,0,.07);min-width:145px;flex:1;}";
	HTML = HTML + ".metric-title{font-size:11px;color:#70627f;margin-bottom:6px;}";
	HTML = HTML + ".metric-value{font-size:24px;font-weight:bold;color:#4b1478;}";
	HTML = HTML + ".metric-note{font-size:11px;color:#81748f;margin-top:4px;}";
	HTML = HTML + ".card{background:white;border:1px solid #e7dbf2;border-radius:16px;padding:15px;margin-bottom:12px;box-shadow:0 3px 12px rgba(0,0,0,.07);}";
	HTML = HTML + ".card h2{margin:0 0 10px 0;font-size:18px;color:#4b1478;}";
	HTML = HTML + ".card h3{margin:8px 0 8px 0;font-size:14px;color:#4b1478;}";
	HTML = HTML + ".notice{background:#fff8df;border:1px solid #ecd77b;border-radius:12px;padding:11px;font-size:12px;line-height:1.45;margin-bottom:10px;}";
	HTML = HTML + ".goodbox{background:#edf9f0;border:1px solid #a8deb4;border-radius:12px;padding:11px;font-size:12px;line-height:1.45;margin-bottom:8px;}";
	HTML = HTML + ".warnbox{background:#fff4dd;border:1px solid #e9c47b;border-radius:12px;padding:11px;font-size:12px;line-height:1.45;margin-bottom:8px;}";
	HTML = HTML + ".risk{background:#fff0f0;border:1px solid #e8a7a7;border-radius:12px;padding:11px;font-size:12px;line-height:1.45;margin-bottom:8px;}";
	HTML = HTML + ".two-cols{display:flex;flex-wrap:wrap;gap:12px;}";
	HTML = HTML + ".col{flex:1;min-width:280px;}";
	HTML = HTML + ".table-wrap{max-height:360px;overflow:auto;border:1px solid #ded2ea;border-radius:12px;}";
	HTML = HTML + "table{width:100%;border-collapse:collapse;background:white;font-size:12px;}";
	HTML = HTML + "th{background:#7b3fb2;color:white;padding:8px;text-align:left;position:sticky;top:0;z-index:1;}";
	HTML = HTML + "td{padding:7px;border-bottom:1px solid #eee7f5;vertical-align:top;}";
	HTML = HTML + "tr:hover{background:#fff6d8;}";
	HTML = HTML + ".num{text-align:center;font-weight:bold;}";
	HTML = HTML + ".empty-cell{text-align:center;color:#777;padding:16px;}";
	HTML = HTML + "input{width:100%;box-sizing:border-box;padding:9px 11px;border:1px solid #cfc3dc;border-radius:10px;font-size:12px;margin-bottom:9px;}";
	HTML = HTML + ".badge{display:inline-block;padding:4px 8px;border-radius:999px;font-size:11px;font-weight:bold;white-space:nowrap;}";
	HTML = HTML + ".ok{background:#e5f8e8;color:#1f7a35;border:1px solid #a6dfb0;}";
	HTML = HTML + ".muted{background:#eeeeee;color:#555;border:1px solid #d0d0d0;}";
	HTML = HTML + ".warn{background:#fff1d6;color:#9a5a00;border:1px solid #e4bd70;}";
	HTML = HTML + ".bad{background:#ffe5e5;color:#9d2323;border:1px solid #e4aaaa;}";
	HTML = HTML + ".blue{background:#e8f1ff;color:#255c99;border:1px solid #b8d3f6;}";
	HTML = HTML + ".rank-row{margin-bottom:9px;}";
	HTML = HTML + ".rank-head{display:flex;justify-content:space-between;font-size:11px;margin-bottom:4px;gap:10px;}";
	HTML = HTML + ".rank-name{font-weight:bold;color:#33273e;}";
	HTML = HTML + ".rank-value{color:#6d5d7d;white-space:nowrap;}";
	HTML = HTML + ".bar{height:10px;background:#eee8f6;border-radius:999px;overflow:hidden;}";
	HTML = HTML + ".bar-fill{height:10px;background:#8d4ac0;border-radius:999px;}";
	HTML = HTML + ".flow{display:flex;flex-wrap:wrap;gap:8px;align-items:stretch;}";
	HTML = HTML + ".flow-step{background:#f8f4ff;border:1px solid #ddc8f2;border-radius:13px;padding:10px;min-width:155px;flex:1;font-size:12px;line-height:1.35;}";
	HTML = HTML + ".flow-step b{color:#4c1478;}";
	HTML = HTML + ".arrow{font-size:20px;color:#7b3fb2;align-self:center;}";
	HTML = HTML + "ul{margin:8px 0 0 18px;padding:0;line-height:1.45;font-size:12px;}";
	HTML = HTML + ".mini{font-size:11px;color:#756984;line-height:1.45;}";
	HTML = HTML + ".timeline{border-left:3px solid #cdb8e5;margin-left:8px;padding-left:12px;}";
	HTML = HTML + ".timeline-item{margin-bottom:10px;background:#faf7ff;border:1px solid #e3d5f2;border-radius:12px;padding:9px;}";
	HTML = HTML + ".timeline-date{font-weight:bold;color:#4b1478;font-size:12px;margin-bottom:4px;}";
	HTML = HTML + ".printbtn{border:0;background:#4b1478;color:white;border-radius:999px;padding:8px 12px;cursor:pointer;font-weight:bold;font-size:12px;}";
	HTML = HTML + "@media print{.tabs,.printbtn{display:none}.tab-content{display:block}.card,.metric,.hero{box-shadow:none}}";
	HTML = HTML + "</style>";

	HTML = HTML + "<script>";
	HTML = HTML + "function openTab(name,btn){";
	HTML = HTML + "var tabs=document.getElementsByClassName('tab-content');";
	HTML = HTML + "for(var i=0;i<tabs.length;i++){tabs[i].className='tab-content';}";
	HTML = HTML + "var buttons=document.getElementsByClassName('tab-button');";
	HTML = HTML + "for(var j=0;j<buttons.length;j++){buttons[j].className='tab-button';}";
	HTML = HTML + "document.getElementById(name).className='tab-content active';";
	HTML = HTML + "btn.className='tab-button active';";
	HTML = HTML + "}";
	HTML = HTML + "function filterTable(tableId,inputId){";
	HTML = HTML + "var input=document.getElementById(inputId);";
	HTML = HTML + "var filter=input.value.toLowerCase();";
	HTML = HTML + "var table=document.getElementById(tableId);";
	HTML = HTML + "var tr=table.getElementsByTagName('tr');";
	HTML = HTML + "for(var i=1;i<tr.length;i++){";
	HTML = HTML + "var txt=tr[i].innerText || tr[i].textContent;";
	HTML = HTML + "if(txt.toLowerCase().indexOf(filter)>-1){tr[i].style.display='';}else{tr[i].style.display='none';}";
	HTML = HTML + "}";
	HTML = HTML + "}";
	HTML = HTML + "</script>";

	HTML = HTML + "</head>";
	HTML = HTML + "<body>";
	HTML = HTML + "<div class='page'>";

	HTML = HTML + "<div class='hero'>";
	HTML = HTML + "<h1>Рабочее место студента — MAX аналитика</h1>";
	HTML = HTML + "<p><b>Студент:</b> " + ЭкранироватьHTML(Строка(Студент)) + "</p>";
	HTML = HTML + "<p>Панель показывает личную посещаемость, уведомления, статистику базы, качество данных, риски, рейтинги и схему обработки.</p>";
	HTML = HTML + "<div class='hero-line'>";
	HTML = HTML + "<span class='pill'>Период: " + ЭкранироватьHTML(ТекстПервойДаты) + " — " + ЭкранироватьHTML(ТекстПоследнейДаты) + "</span>";
	HTML = HTML + "<span class='pill'>Записей студента: " + Строка(КоличествоСтрокСтудента) + "</span>";
	HTML = HTML + "<span class='pill'>Уведомлений: " + Строка(КоличествоУведомленийСтудента) + "</span>";
	HTML = HTML + "<span class='pill'>Качество данных: " + Строка(ИндексКачестваСтудента) + "%</span>";
	HTML = HTML + "</div>";
	HTML = HTML + "</div>";

	HTML = HTML + "<div class='tabs'>";
	HTML = HTML + "<button class='tab-button active' onclick=""openTab('tabSummary',this)"">Сводка</button>";
	HTML = HTML + "<button class='tab-button' onclick=""openTab('tabControl',this)"">Контроль</button>";
	HTML = HTML + "<button class='tab-button' onclick=""openTab('tabNotifications',this)"">Уведомления</button>";
	HTML = HTML + "<button class='tab-button' onclick=""openTab('tabJournal',this)"">Журнал</button>";
	HTML = HTML + "<button class='tab-button' onclick=""openTab('tabRatings',this)"">Рейтинги</button>";
	HTML = HTML + "<button class='tab-button' onclick=""openTab('tabDatabase',this)"">База</button>";
	HTML = HTML + "<button class='tab-button' onclick=""openTab('tabQuality',this)"">Качество данных</button>";
	HTML = HTML + "<button class='tab-button' onclick=""openTab('tabProcess',this)"">Схема</button>";
	HTML = HTML + "<button class='tab-button' onclick=""openTab('tabRecommendations',this)"">Рекомендации</button>";
	HTML = HTML + "</div>";


	// ------------------------------------------------------------
	// Вкладка: Сводка
	// ------------------------------------------------------------

	HTML = HTML + "<div id='tabSummary' class='tab-content active'>";

	HTML = HTML + "<div class='grid'>";
	HTML = HTML + СформироватьHTMLМетрика("Записей студента", КоличествоСтрокСтудента, "строк в журнале");
	HTML = HTML + СформироватьHTMLМетрика("Часов студента", ВсегоЧасовСтудента, "сумма часов");
	HTML = HTML + СформироватьHTMLМетрика("Уведомлений", КоличествоУведомленийСтудента, "создано студентом");
	HTML = HTML + СформироватьHTMLМетрика("Справок", УведомленийСФайломСтудента, "с прикрепленным файлом");
	HTML = HTML + СформироватьHTMLМетрика("Предметов", ПредметыСтудента.Количество(), "уникальных предметов");
	HTML = HTML + СформироватьHTMLМетрика("Преподавателей", ПреподавателиСтудента.Количество(), "уникальных преподавателей");
	HTML = HTML + СформироватьHTMLМетрика("Дней", УникальныеДатыСтудента.Количество(), "уникальных дат");
	HTML = HTML + СформироватьHTMLМетрика("Среднее часов", СреднееЧасовСтудента, "на одну запись");
	HTML = HTML + СформироватьHTMLМетрика("Качество данных", Строка(ИндексКачестваСтудента) + "%", "заполненность ключевых полей");
	HTML = HTML + СформироватьHTMLМетрика("Доля в базе", Строка(ДоляСтудентаВБазе) + "%", "от всех строк журнала");
	HTML = HTML + "</div>";

	HTML = HTML + "<div class='two-cols'>";
	HTML = HTML + "<div class='col'><div class='card'><h2>Главные выводы</h2><ul>" + HTMLВыводы + "</ul></div></div>";
	HTML = HTML + "<div class='col'><div class='card'><h2>Риски и внимание</h2>" + HTMLРиски + "</div></div>";
	HTML = HTML + "</div>";

	HTML = HTML + "<div class='card'>";
	HTML = HTML + "<h2>Паспорт данных студента</h2>";
	HTML = HTML + "<div class='grid'>";
	HTML = HTML + СформироватьHTMLМетрика("Первая запись", ТекстПервойДаты, "самая ранняя дата");
	HTML = HTML + СформироватьHTMLМетрика("Последняя запись", ТекстПоследнейДаты, "самая свежая дата");
	HTML = HTML + СформироватьHTMLМетрика("Периодов", ПериодыСтудента.Количество(), "учебные периоды");
	HTML = HTML + СформироватьHTMLМетрика("Групп", ГруппыСтудента.Количество(), "группы в строках");
	HTML = HTML + "</div>";
	HTML = HTML + "</div>";

	HTML = HTML + "</div>";


	// ------------------------------------------------------------
	// Вкладка: Контроль
	// ------------------------------------------------------------

	HTML = HTML + "<div id='tabControl' class='tab-content'>";

	HTML = HTML + "<div class='card'>";
	HTML = HTML + "<h2>Контрольный экран для деканата</h2>";
	HTML = HTML + "<div class='notice'>Этот блок показывает, что нужно проверить по выбранному студенту: есть ли журнал, есть ли уведомления, приложены ли справки, заполнены ли ключевые поля.</div>";
	HTML = HTML + "<div class='grid'>";
	HTML = HTML + СформироватьHTMLМетрика("Журнал", ЕслиHTML(КоличествоСтрокСтудента > 0, "Есть", "Нет"), "наличие записей");
	HTML = HTML + СформироватьHTMLМетрика("Уведомления", ЕслиHTML(КоличествоУведомленийСтудента > 0, "Есть", "Нет"), "наличие обращений");
	HTML = HTML + СформироватьHTMLМетрика("Без справки", УведомленийБезФайлаСтудента, "требует проверки");
	HTML = HTML + СформироватьHTMLМетрика("Пустых полей", ВсегоПустыхПолейСтудента, "по ключевым реквизитам");
	HTML = HTML + "</div>";
	HTML = HTML + "<h3>Рекомендованные действия</h3>";
	HTML = HTML + "<ul>" + HTMLРекомендации + "</ul>";
	HTML = HTML + "</div>";

	HTML = HTML + "</div>";


	// ------------------------------------------------------------
	// Вкладка: Уведомления
	// ------------------------------------------------------------

	HTML = HTML + "<div id='tabNotifications' class='tab-content'>";

	HTML = HTML + "<div class='grid'>";
	HTML = HTML + СформироватьHTMLМетрика("Всего уведомлений", КоличествоУведомленийСтудента, "по студенту");
	HTML = HTML + СформироватьHTMLМетрика("Со справкой", УведомленийСФайломСтудента, "есть файл");
	HTML = HTML + СформироватьHTMLМетрика("Без справки", УведомленийБезФайлаСтудента, "нет файла");
	HTML = HTML + СформироватьHTMLМетрика("Доля со справкой", Строка(ДоляСправокСтудента) + "%", "по студенту");
	HTML = HTML + "</div>";

	HTML = HTML + "<div class='card'>";
	HTML = HTML + "<h2>Мои отправленные уведомления</h2>";
	HTML = HTML + "<input id='searchNotifications' type='text' onkeyup=""filterTable('notificationsTable','searchNotifications')"" placeholder='Поиск по дате, причине, справке или статусу...'>";
	HTML = HTML + "<div class='table-wrap'>";
	HTML = HTML + "<table id='notificationsTable'>";
	HTML = HTML + "<thead><tr><th>Дата отправки</th><th>Причина</th><th>Справка</th><th>Статус</th></tr></thead>";
	HTML = HTML + "<tbody>" + СтрокиУведомленийСтудента + "</tbody>";
	HTML = HTML + "</table>";
	HTML = HTML + "</div>";
	HTML = HTML + "<div class='mini'>Статус пока выводится как «На рассмотрении». Для полноценного процесса добавь в документ уведомления реквизит Статус.</div>";
	HTML = HTML + "</div>";

	HTML = HTML + "<div class='card'><h2>Частые причины студента</h2>" + СформироватьHTMLРейтинг(РейтингПричинСтудента, "раз", 10) + "</div>";

	HTML = HTML + "</div>";


	// ------------------------------------------------------------
	// Вкладка: Журнал
	// ------------------------------------------------------------

	HTML = HTML + "<div id='tabJournal' class='tab-content'>";

	HTML = HTML + "<div class='card'>";
	HTML = HTML + "<h2>Журнал посещаемости / пропусков</h2>";
	HTML = HTML + "<input id='searchJournal' type='text' onkeyup=""filterTable('journalTable','searchJournal')"" placeholder='Поиск по дате, виду занятия, периоду, аудитории, преподавателю, предмету или группе...'>";
	HTML = HTML + "<div class='table-wrap'>";
	HTML = HTML + "<table id='journalTable'>";
	HTML = HTML + "<thead><tr>";
	HTML = HTML + "<th>Дата</th><th>Вид занятия</th><th>Период</th><th>Аудитория</th><th>Учебная группа</th><th>Преподаватель</th><th>Предмет</th><th>Группа</th><th>Часы</th>";
	HTML = HTML + "</tr></thead>";
	HTML = HTML + "<tbody>" + СтрокиЖурналаСтудента + "</tbody>";
	HTML = HTML + "</table>";
	HTML = HTML + "</div>";
	HTML = HTML + "</div>";

	HTML = HTML + "</div>";


	// ------------------------------------------------------------
	// Вкладка: Рейтинги
	// ------------------------------------------------------------

	HTML = HTML + "<div id='tabRatings' class='tab-content'>";

	HTML = HTML + "<div class='two-cols'>";
	HTML = HTML + "<div class='col'><div class='card'><h2>Предметы по часам</h2>" + СформироватьHTMLРейтинг(РейтингПредметовПоЧасам, "ч.", 10) + "</div></div>";
	HTML = HTML + "<div class='col'><div class='card'><h2>Предметы по записям</h2>" + СформироватьHTMLРейтинг(РейтингПредметовПоЗаписям, "зап.", 10) + "</div></div>";
	HTML = HTML + "</div>";

	HTML = HTML + "<div class='two-cols'>";
	HTML = HTML + "<div class='col'><div class='card'><h2>Преподаватели</h2>" + СформироватьHTMLРейтинг(РейтингПреподавателей, "зап.", 10) + "</div></div>";
	HTML = HTML + "<div class='col'><div class='card'><h2>Группы</h2>" + СформироватьHTMLРейтинг(РейтингГрупп, "зап.", 10) + "</div></div>";
	HTML = HTML + "</div>";

	HTML = HTML + "<div class='two-cols'>";
	HTML = HTML + "<div class='col'><div class='card'><h2>Месяцы</h2>" + СформироватьHTMLРейтинг(РейтингМесяцев, "зап.", 12) + "</div></div>";
	HTML = HTML + "<div class='col'><div class='card'><h2>Виды занятий</h2>" + СформироватьHTMLРейтинг(РейтингВидовЗанятий, "зап.", 10) + "</div></div>";
	HTML = HTML + "</div>";

	HTML = HTML + "<div class='two-cols'>";
	HTML = HTML + "<div class='col'><div class='card'><h2>Учебные периоды</h2>" + СформироватьHTMLРейтинг(РейтингПериодов, "зап.", 10) + "</div></div>";
	HTML = HTML + "<div class='col'><div class='card'><h2>Аудитории</h2>" + СформироватьHTMLРейтинг(РейтингАудиторий, "зап.", 10) + "</div></div>";
	HTML = HTML + "</div>";

	HTML = HTML + "</div>";


	// ------------------------------------------------------------
	// Вкладка: База
	// ------------------------------------------------------------

	HTML = HTML + "<div id='tabDatabase' class='tab-content'>";

	HTML = HTML + "<div class='grid'>";
	HTML = HTML + СформироватьHTMLМетрика("Документов журнала", УникальныеДокументыЖурнала.Количество(), "ЖурналПосещаемости");
	HTML = HTML + СформироватьHTMLМетрика("Строк журнала", КоличествоСтрокВБазе, "табличная часть");
	HTML = HTML + СформироватьHTMLМетрика("Часов в базе", ВсегоЧасовВБазе, "сумма часов");
	HTML = HTML + СформироватьHTMLМетрика("Студентов", УникальныеСтуденты.Количество(), "уникальные");
	HTML = HTML + СформироватьHTMLМетрика("Преподавателей", УникальныеПреподаватели.Количество(), "уникальные");
	HTML = HTML + СформироватьHTMLМетрика("Предметов", УникальныеПредметы.Количество(), "уникальные");
	HTML = HTML + СформироватьHTMLМетрика("Групп", УникальныеГруппы.Количество(), "уникальные");
	HTML = HTML + СформироватьHTMLМетрика("Периодов", УникальныеПериоды.Количество(), "учебные");
	HTML = HTML + СформироватьHTMLМетрика("Аудиторий", УникальныеАудитории.Количество(), "уникальные");
	HTML = HTML + СформироватьHTMLМетрика("Видов занятий", УникальныеВидыЗанятий.Количество(), "уникальные");
	HTML = HTML + СформироватьHTMLМетрика("Уведомлений", КоличествоУведомленийВБазе, "вся база");
	HTML = HTML + СформироватьHTMLМетрика("Со справкой", Строка(ДоляСправокБаза) + "%", "доля уведомлений");
	HTML = HTML + "</div>";

	HTML = HTML + "<div class='two-cols'>";
	HTML = HTML + "<div class='col'><div class='card'><h2>База: предметы</h2>" + СформироватьHTMLРейтинг(РейтингБазыПредметы, "зап.", 10) + "</div></div>";
	HTML = HTML + "<div class='col'><div class='card'><h2>База: преподаватели</h2>" + СформироватьHTMLРейтинг(РейтингБазыПреподаватели, "зап.", 10) + "</div></div>";
	HTML = HTML + "</div>";

	HTML = HTML + "<div class='two-cols'>";
	HTML = HTML + "<div class='col'><div class='card'><h2>База: группы</h2>" + СформироватьHTMLРейтинг(РейтингБазыГруппы, "зап.", 10) + "</div></div>";
	HTML = HTML + "<div class='col'><div class='card'><h2>База: месяцы</h2>" + СформироватьHTMLРейтинг(РейтингБазыМесяцы, "зап.", 12) + "</div></div>";
	HTML = HTML + "</div>";

	HTML = HTML + "</div>";


	// ------------------------------------------------------------
	// Вкладка: Качество данных
	// ------------------------------------------------------------

	HTML = HTML + "<div id='tabQuality' class='tab-content'>";

	HTML = HTML + "<div class='grid'>";
	HTML = HTML + СформироватьHTMLМетрика("Качество студента", Строка(ИндексКачестваСтудента) + "%", "по 5 ключевым полям");
	HTML = HTML + СформироватьHTMLМетрика("Качество базы", Строка(ИндексКачестваБазы) + "%", "по всем строкам");
	HTML = HTML + СформироватьHTMLМетрика("Пустых у студента", ВсегоПустыхПолейСтудента, "контрольные поля");
	HTML = HTML + СформироватьHTMLМетрика("Пустых в базе", ВсегоПустыхПолейБаза, "контрольные поля");
	HTML = HTML + "</div>";

	HTML = HTML + "<div class='card'>";
	HTML = HTML + "<h2>Проверка заполненности</h2>";
	HTML = HTML + "<div class='table-wrap'>";
	HTML = HTML + "<table>";
	HTML = HTML + "<thead><tr><th>Проблема</th><th>По студенту</th><th>По всей базе</th><th>Комментарий</th></tr></thead>";
	HTML = HTML + "<tbody>" + СтрокиКонтроляКачества + "</tbody>";
	HTML = HTML + "</table>";
	HTML = HTML + "</div>";
	HTML = HTML + "</div>";

	HTML = HTML + "</div>";


	// ------------------------------------------------------------
	// Вкладка: Схема процесса
	// ------------------------------------------------------------

	HTML = HTML + "<div id='tabProcess' class='tab-content'>";

	HTML = HTML + "<div class='card'>";
	HTML = HTML + "<h2>Полная схема процесса</h2>";
	HTML = HTML + "<div class='flow'>";
	HTML = HTML + "<div class='flow-step'><b>1. Студент</b><br>Выбирает ФИО, дату, причину и прикрепляет справку.</div>";
	HTML = HTML + "<div class='arrow'>→</div>";
	HTML = HTML + "<div class='flow-step'><b>2. 1С</b><br>Создает документ «УведомлениеОбОтсутствии».</div>";
	HTML = HTML + "<div class='arrow'>→</div>";
	HTML = HTML + "<div class='flow-step'><b>3. Преподаватель</b><br>Заполняет «ЖурналПосещаемости».</div>";
	HTML = HTML + "<div class='arrow'>→</div>";
	HTML = HTML + "<div class='flow-step'><b>4. Деканат</b><br>Сверяет журнал, причину и справку.</div>";
	HTML = HTML + "<div class='arrow'>→</div>";
	HTML = HTML + "<div class='flow-step'><b>5. Решение</b><br>Утверждение или отклонение причины.</div>";
	HTML = HTML + "</div>";
	HTML = HTML + "</div>";

	HTML = HTML + "<div class='card'>";
	HTML = HTML + "<h2>Что показывает текущая панель</h2>";
	HTML = HTML + "<ul>";
	HTML = HTML + "<li>Данные выбранного студента из журнала посещаемости.</li>";
	HTML = HTML + "<li>Уведомления студента об отсутствии.</li>";
	HTML = HTML + "<li>Наличие или отсутствие подтверждающего файла.</li>";
	HTML = HTML + "<li>Сводную статистику по всей базе.</li>";
	HTML = HTML + "<li>Качество заполнения данных.</li>";
	HTML = HTML + "<li>Рейтинги по предметам, преподавателям, группам, периодам и месяцам.</li>";
	HTML = HTML + "</ul>";
	HTML = HTML + "</div>";

	HTML = HTML + "</div>";


	// ------------------------------------------------------------
	// Вкладка: Рекомендации
	// ------------------------------------------------------------

	HTML = HTML + "<div id='tabRecommendations' class='tab-content'>";

	HTML = HTML + "<div class='card'>";
	HTML = HTML + "<h2>Что добавить в конфигурацию для идеального процесса</h2>";
	HTML = HTML + "<div class='notice'>Это не обязательно для работы текущего HTML, но сделает систему завершенной как реальный учебный бизнес-процесс.</div>";
	HTML = HTML + "<ul>";
	HTML = HTML + "<li>Добавить в документ <b>УведомлениеОбОтсутствии</b> реквизит <b>ДатаПропуска</b>.</li>";
	HTML = HTML + "<li>Добавить реквизит <b>Статус</b>: На рассмотрении, Утверждена, Отклонена.</li>";
	HTML = HTML + "<li>Добавить реквизит <b>КомментарийДеканата</b>.</li>";
	HTML = HTML + "<li>Добавить форму деканата «Уведомления на рассмотрении».</li>";
	HTML = HTML + "<li>Добавить кнопку утверждения и кнопку отклонения.</li>";
	HTML = HTML + "<li>Добавить автоматическую сверку: есть пропуск в журнале, но нет уведомления.</li>";
	HTML = HTML + "<li>Добавить отдельный регистр сведений «ФактПосещаемости», если нужно строить отчеты не только по документам.</li>";
	HTML = HTML + "</ul>";
	HTML = HTML + "</div>";

	HTML = HTML + "<div class='card'>";
	HTML = HTML + "<h2>Печать / демонстрация</h2>";
	HTML = HTML + "<div class='notice'>Можно распечатать эту HTML-панель как аналитическую справку по студенту.</div>";
	HTML = HTML + "<button class='printbtn' onclick='window.print()'>Печать панели</button>";
	HTML = HTML + "</div>";

	HTML = HTML + "</div>";

	HTML = HTML + "</div>";
	HTML = HTML + "</body>";
	HTML = HTML + "</html>";

	Возврат HTML;

КонецФункции


&НаСервере
Функция СформироватьHTMLСообщение(Класс, Текст)

	Возврат "<div class='" + Класс + "'>" + ЭкранироватьHTML(Текст) + "</div>";

КонецФункции


&НаСервере
Функция СформироватьHTMLСтрокуКачества(НазваниеПроблемы, КоличествоСтудент, КоличествоБаза)

	Если КоличествоСтудент > 0 Тогда
		КлассСтудент = "badge bad";
		Комментарий = "Требуется исправить";
	Иначе
		КлассСтудент = "badge ok";
		Комментарий = "По студенту нормально";
	КонецЕсли;

	Если КоличествоБаза > 0 Тогда
		КлассБаза = "badge warn";
	Иначе
		КлассБаза = "badge ok";
	КонецЕсли;

	HTML = "";
	HTML = HTML + "<tr>";
	HTML = HTML + "<td>" + ЭкранироватьHTML(НазваниеПроблемы) + "</td>";
	HTML = HTML + "<td><span class='" + КлассСтудент + "'>" + Строка(КоличествоСтудент) + "</span></td>";
	HTML = HTML + "<td><span class='" + КлассБаза + "'>" + Строка(КоличествоБаза) + "</span></td>";
	HTML = HTML + "<td>" + ЭкранироватьHTML(Комментарий) + "</td>";
	HTML = HTML + "</tr>";

	Возврат HTML;

КонецФункции


&НаСервере
Функция ЕслиHTML(Условие, ЗначениеИстина, ЗначениеЛожь)

	Если Условие Тогда
		Возврат ЗначениеИстина;
	Иначе
		Возврат ЗначениеЛожь;
	КонецЕсли;

КонецФункции


&НаСервере
Функция ФорматДатыHTML(ДатаЗначение)

	Если Не ЗначениеЗаполнено(ДатаЗначение) Тогда
		Возврат "";
	КонецЕсли;

	Возврат Формат(ДатаЗначение, "ДФ=dd.MM.yyyy");

КонецФункции


&НаСервере
Функция ЭкранироватьHTML(Значение)

	Текст = Строка(Значение);

	Текст = СтрЗаменить(Текст, "&", "&amp;");
	Текст = СтрЗаменить(Текст, "<", "&lt;");
	Текст = СтрЗаменить(Текст, ">", "&gt;");
	Текст = СтрЗаменить(Текст, """", "&quot;");
	Текст = СтрЗаменить(Текст, "'", "&#39;");

	Возврат Текст;

КонецФункции
 
